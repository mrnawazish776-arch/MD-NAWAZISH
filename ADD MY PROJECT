#include <stdio.h>

int main()
{
    // Store all registered enrollment numbers

    int enrollment[33] = {
        218, 219, 220, 222, 225, 226, 227, 228,
        230, 231, 233, 234, 235, 236, 237, 241,
        242, 243, 244, 245, 246, 247, 248, 249,
        250, 254, 255, 258, 259, 292, 580, 576, 746
    };

    // Declare variables

    int input[100];
    int n, i, j;
    int found;
    int present = 0;
    int absent = 0;

    // Display project heading

    printf("\n");
    printf("====================================\n");
    printf("HELLO,FRIEND'S MY NAME IS : NAWAZISH\n");
    printf("       ATTENDANCE IN CLASS\n");
    printf("====================================\n");

  

    printf("\nEnter total number of students: ");
    scanf("%d", &n);

    

    if(n < 1 || n > 100)
    {
        printf("\nInvalid number of students!");
        return 0;
    }

 

    printf("\nEnter last three digits of enrollment numbers:\n");

    for(i = 0; i < n; i++)
    {
        printf("Student %d: ", i + 1);
        scanf("%d", &input[i]);
    }

   

    printf("\n");
    printf("====================================\n");
    printf("         ATTENDANCE REPORT\n");
    printf("====================================\n");

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < 33; j++)
        {
            if(input[i] == enrollment[j])
            {
                found = 1;
                break;
            }
        }

        if(found == 1)
        {
            printf("%d - PRESENT\n", input[i]);
            present++;
        }
        else
        {
            printf("%d - ABSENT\n", input[i]);
            absent++;
        }
    }

  

    printf("\n");
    printf("====================================\n");
    printf("         ABSENT STUDENTS\n");
    printf("====================================\n");

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < 33; j++)
        {
            if(input[i] == enrollment[j])
            {
                found = 1;
                break;
            }
        }

        if(found == 0)
        {
            printf("Enrollment: %d\n", input[i]);
        }
    }

   

    printf("\n");
    printf("====================================\n");
    printf("         FINAL SUMMARY\n");
    printf("====================================\n");

    printf("Total Students : %d\n", n);
    printf("Total Present  : %d\n", present);
    printf("Total Absent   : %d\n", absent);

    printf("\n====================================\n");
    printf("       ATTENDANCE COMPLETED\n");
    printf("====================================\n");

    return 0;
}
